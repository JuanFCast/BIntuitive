{
  "name": "bintuitive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "validate:content": "tsc -p tsconfig.validate.json && node -r ./scripts/resolveAlias.cjs .content-check/scripts/validateContent.js",
    "check:migration": "tsc -p tsconfig.migration.json && node -r ./scripts/resolveAlias.cjs .content-check/scripts/checkMigration.js",
    "check:tracing": "tsc -p tsconfig.tracing.json && node -r ./scripts/resolveAlias.cjs .content-check/scripts/checkTracing.js",
    "check:memory": "tsc -p tsconfig.memory.json && node -r ./scripts/resolveAlias.cjs .content-check/scripts/checkMemory.js",
    "check:coloring": "tsc -p tsconfig.coloring.json && node -r ./scripts/resolveAlias.cjs .content-check/scripts/checkColoring.js"
  },
  "dependencies": {
    "next": "^15.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
