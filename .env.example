# Copia este archivo como `.env.local` y rellena los dos valores con los de tu
# proyecto de Supabase (Project Settings → API). Los dos son públicos: van
# dentro de la aplicación. Nunca pongas aquí la `service_role` ni la `secret`.
#
# Sin ellos la aplicación funciona igual, solo como invitado.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
